# OpenAI API Key
OPENAI_API_KEY=your-api-key-here

# Model settings (optional)
OPENAI_MODEL=gpt-4o

# LlamaCloud API Key (for LlamaParse)
# Get from: https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your-llamacloud-api-key

# PDF Vision Fallback (テキスト抽出が不十分なページをGPT-4oで再抽出)
PDF_VISION_ENABLED=false
PDF_VISION_MODEL=gpt-4o
PDF_VISION_FALLBACK_THRESHOLD=100  # ページ単位の文字数閾値

# Redis (自動設定されるため通常は変更不要)
REDIS_URL=redis://redis:6379

# ChromaDB (自動設定されるため通常は変更不要)
CHROMA_HOST=chroma
CHROMA_PORT=8000

# PostgreSQL (自動設定されるため通常は変更不要)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chatbot
